{
  "schema_version": "1.0",
  "name": "FEATURES",
  "primary_key": ["feature_id"],
  "columns": [
    {
      "name": "feature_category",
      "type": "string",
      "required": true,
      "ref": {
        "table": "FEATURE_CATEGORIES",
        "column": "category_title"
      },
      "description": "카테고리 제목(표시용, FEATURE_CATEGORIES.category_title)."
    },
    {
      "name": "category_key",
      "type": "string",
      "required": true,
      "ref": {
        "table": "FEATURE_CATEGORIES",
        "column": "category_key"
      },
      "description": "기능 카테고리 키(FK -> FEATURE_CATEGORIES.category_key)."
    },
    {
      "name": "feature_title",
      "type": "string",
      "required": true,
      "description": "기능 제목(사람이 읽는 라벨)."
    },
    {
      "name": "feature_id",
      "type": "string",
      "required": true,
      "description": "기능 ID(PK). 안정적인 참조 키."
    },
    {
      "name": "release_phase",
      "type": "string",
      "required": false,
      "enum": ["BACKLOG", "CBT-W1", "CBT-NEXT", "OBT", "MVP", "LICENSE-BETA", "LATER"],
      "description": "기능의 릴리즈 단계 태그.",
      "enum_descriptions": {
        "BACKLOG": "아직 구체 릴리즈에 배정하지 않은 후보 기능.",
        "CBT-W1": "초기 CBT Wave 1 검증 범위.",
        "CBT-NEXT": "CBT 이후 후속 검증 후보.",
        "OBT": "공개 베타 범위.",
        "MVP": "정식 최소 제품 범위.",
        "LICENSE-BETA": "계정·라이선스·구독 또는 entitlement 상태를 제품 흐름에 처음 연결해 검증하는 제한 범위.",
        "LATER": "현재 릴리즈 계획 밖의 장기 후보."
      }
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "기능 한 줄 설명(무엇을 하는지)."
    },
    {
      "name": "related_ui",
      "type": "string",
      "required": false,
      "ref": {
        "table": "WINDOW_STRUCTURE",
        "column": "structure_key"
      },
      "description": "UI 구조 참조(옵션, FK -> WINDOW_STRUCTURE.structure_key). 기능과 가장 연관이 높은 대표 UI 영역."
    },
    {
      "name": "entitlement_key",
      "type": "string",
      "required": false,
      "enum": ["public_access", "core_license", "basic_subscription", "go_subscription", "automation_addon"],
      "description": "이 기능을 사용할 수 있게 하는 제품 권한 키(enum). 가격/패키징 정본은 BUSINESS 문서가 관리한다.",
      "enum_descriptions": {
        "public_access": "app unlock 전 public/pre-auth surface.",
        "core_license": "Core License 기본 기능.",
        "basic_subscription": "Basic 구독 tier 기능.",
        "go_subscription": "Go 구독 tier 기능.",
        "automation_addon": "자동화 add-on 기능."
      }
    }
  ]
}
