{
  "schema_version": "1.0",
  "name": "INTERACTIONS",
  "primary_key": ["interaction_id"],
  "columns": [
    {
      "name": "interaction_title",
      "type": "string",
      "required": true,
      "description": "인터랙션 제목(사람이 읽는 라벨)."
    },
    {
      "name": "interaction_id",
      "type": "string",
      "required": true,
      "description": "인터랙션 ID(PK). 안정적인 참조 키. 예: FMW-001-open_new_file_manager_window"
    },
    {
      "name": "interaction_type",
      "type": "string",
      "required": false,
      "enum": ["command", "input", "display", "background"],
      "description": "인터랙션 타입.",
      "enum_descriptions": {
        "command": "사용자 호출 또는 실행.",
        "input": "값이나 상태를 변경하는 입력.",
        "display": "사용자에게 정보 표시.",
        "background": "직접 호출 없이 수행되는 백그라운드 작업."
      }
    },
    {
      "name": "feature",
      "type": "string",
      "required": false,
      "ref": {
        "table": "FEATURES",
        "column": "feature_title"
      },
      "description": "기능 제목(FEATURES.feature_title). 보통 feature_id로 참조된 기능과 동일한 제목을 적습니다."
    },
    {
      "name": "category_key",
      "type": "string",
      "required": false,
      "ref": {
        "table": "FEATURES",
        "column": "category_key"
      },
      "description": "기능 카테고리 키(FEATURES.category_key)."
    },
    {
      "name": "feature_id",
      "type": "string",
      "required": false,
      "ref": {
        "table": "FEATURES",
        "column": "feature_id"
      },
      "description": "기능 ID(FK -> FEATURES.feature_id)."
    },
    {
      "name": "status",
      "type": "string",
      "required": false,
      "enum": ["idea", "drafted", "planned", "implementing", "shipped", "deprecated"],
      "description": "인터랙션 기획 성숙도 및 구현 상태.",
      "enum_descriptions": {
        "idea": "백로그 후보. 스펙 작성 전.",
        "drafted": "스펙 초안 작성됨. 아직 리뷰/확정 전.",
        "planned": "스펙 확정. 구현 착수 가능.",
        "implementing": "구현 중.",
        "shipped": "구현 완료, 현재 빌드에 포함.",
        "deprecated": "제거됨 또는 대체됨."
      }
    },
    {
      "name": "phase",
      "type": "string",
      "required": false,
      "enum": ["-", "now", "next", "later"],
      "description": "작업 스케줄링. `-`는 안정(작업 불필요), `now`는 이번 cycle, `next`는 다음 cycle, `later`는 타임라인 미확정.",
      "enum_descriptions": {
        "-": "안정. 작업 필요 없음.",
        "now": "이번 cycle 작업 대상.",
        "next": "다음 cycle 작업 예정.",
        "later": "계획됨, 타임라인 미확정."
      }
    },
    {
      "name": "summary",
      "type": "string",
      "required": false,
      "description": "인터랙션 한 줄 요약(무엇을 하는지)."
    },
    {
      "name": "related_region",
      "type": "string",
      "required": false,
      "ref": {
        "table": "WINDOW_STRUCTURE",
        "column": "structure_key"
      },
      "description": "UI 영역 참조(옵션, FK -> WINDOW_STRUCTURE.structure_key). 인터랙션이 발생/노출되는 대표 UI 영역."
    },
    {
      "name": "menu",
      "type": "string",
      "required": false,
      "ref": {
        "table": "MENUS",
        "column": "menu_node_id"
      },
      "description": "메뉴 노드 ID(FK -> MENUS.menu_node_id)."
    },
    {
      "name": "shortcut",
      "type": "string",
      "required": false,
      "description": "단축키(자유 형식). 예: ⌘N, ⌘⇧W, ESC."
    }
  ]
}
