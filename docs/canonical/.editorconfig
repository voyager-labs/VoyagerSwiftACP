root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 4
trim_trailing_whitespace = false

[*.json]
indent_size = 2
insert_final_newline = true

[*.jsonc]
indent_size = 2

[*.jsonl]
indent_style = space
indent_size = 2

[*.tsv]
end_of_line = lf
indent_style = tab
trim_trailing_whitespace = false
