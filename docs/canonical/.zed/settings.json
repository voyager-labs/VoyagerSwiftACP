{
  "languages": {
    "Markdown": {
      "formatter": {
        "external": {
          "command": "npm",
          "arguments": ["exec", "--no", "--", "prettier", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": ["markdownlint", "..."],
      "remove_trailing_whitespace_on_save": false
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "npm",
          "arguments": ["exec", "--no", "--", "prettier", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "npm",
          "arguments": ["exec", "--no", "--", "prettier", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TOML": {
      "formatter": {
        "external": {
          "command": "npm",
          "arguments": ["exec", "--no", "--", "taplo", "format", "-", "--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
