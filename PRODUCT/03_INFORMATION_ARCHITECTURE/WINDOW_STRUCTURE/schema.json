{
  "schema_version": "1.0",
  "name": "WINDOW_STRUCTURE",
  "primary_key": ["structure_key"],
  "null_values": ["-"],
  "columns": [
    {
      "name": "window_id",
      "type": "string",
      "required": true,
      "description": "윈도우 식별자(예: file_manager_window)."
    },
    {
      "name": "parent_region_id",
      "type": "string",
      "required": false,
      "ref": {
        "table": "WINDOW_STRUCTURE",
        "columns": ["window_id", "parent_region_id"],
        "references": ["window_id", "region_id"]
      },
      "description": "같은 윈도우 내 상위 영역 ID(FK -> WINDOW_STRUCTURE(window_id, region_id)). 루트는 '-' 사용."
    },
    {
      "name": "region_id",
      "type": "string",
      "required": true,
      "description": "윈도우 내 영역(region) ID."
    },
    {
      "name": "region_label",
      "type": "string",
      "required": false,
      "description": "영문 라벨."
    },
    {
      "name": "region_label_ko",
      "type": "string",
      "required": false,
      "description": "한글 라벨."
    },
    {
      "name": "level",
      "type": "number",
      "required": false,
      "description": "계층 레벨(1 = 루트)."
    },
    {
      "name": "slot_type",
      "type": "string",
      "required": false,
      "enum": [
        "root",
        "pane",
        "section",
        "overlay",
        "mode"
      ],
      "description": "영역 역할/타입(예: root, pane, section, overlay, mode)."
    },
    {
      "name": "structure_key",
      "type": "string",
      "required": true,
      "description": "안정적인 계층 키(PK). 다른 테이블에서 UI 참조 키로 사용(예: FEATURES.related_ui, INTERACTIONS.related_region)."
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "영역 설명."
    },
    {
      "name": "objects",
      "type": "string",
      "required": false,
      "ref": {
        "table": "OBJECTS",
        "column": "key"
      },
      "description": "연관 오브젝트 키(OBJECTS.key). 다중 값이 필요하면 '|'로 구분."
    },
    {
      "name": "release_phase",
      "type": "string",
      "required": false,
      "enum": [
        "CBT",
        "OBT",
        "MVP",
        "LATER"
      ],
      "description": "릴리즈 단계 태그(예: CBT, OBT, MVP, LATER)."
    }
  ]
}
