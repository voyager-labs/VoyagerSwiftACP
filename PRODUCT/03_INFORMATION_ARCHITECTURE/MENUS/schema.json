{
  "schema_version": "1.0",
  "name": "MENUS",
  "primary_key": ["menu_node_id"],
  "columns": [
    {
      "name": "menu_node_id",
      "type": "string",
      "required": true,
      "description": "메뉴 노드 식별자(PK). 안정적인 참조 키."
    },
    {
      "name": "menu_scope",
      "type": "string",
      "required": false,
      "description": "메뉴를 묶기 위한 스코프 키(예: app_main, entry_context)."
    },
    {
      "name": "menu_type",
      "type": "string",
      "required": false,
      "enum": [
        "menu_bar",
        "main_menu",
        "context_menu",
        "submenu",
        "section"
      ],
      "description": "메뉴 타입."
    },
    {
      "name": "parent_menu_node",
      "type": "string",
      "required": false,
      "ref": {
        "table": "MENUS",
        "column": "menu_node_id"
      },
      "description": "상위 메뉴 노드 ID(FK -> MENUS.menu_node_id). 루트는 '-' 사용."
    },
    {
      "name": "level",
      "type": "number",
      "required": false,
      "description": "메뉴 계층 레벨(1 = 루트)."
    },
    {
      "name": "menu_label",
      "type": "string",
      "required": false,
      "description": "표시 라벨(해당 없으면 '-'). 예: File, Edit, View."
