{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[swift]": {
    "editor.defaultFormatter": "vknabel.vscode-swiftformat"
  },
  "swiftformat.configSearchPaths": [
    "${workspaceFolder}/apps/macos/.swiftformat"
  ],
  "swiftformat.path": "/opt/homebrew/bin/swiftformat",
  "swiftlint.path": "/opt/homebrew/bin/swiftlint",
  "notebook.formatOnSave.enabled": true,
  "cSpell.customDictionaries": {
    "custom-dictionary-workspace": {
      "name": "custom-dictionary-workspace",
      "path": "${workspaceFolder}/.cspell/custom-dictionary-workspace.txt",
      "addWords": true,
      "scope": "workspace"
    }
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "README.md": ".*, pyproject.toml, uv.lock, *.json"
  },
  "files.exclude": {
    "**/*cache": true,
    "**/__pycache__": true,
    ".venv": true
  },
  "search.exclude": {
    "notebooks/test-files": true
  },
  "evenBetterToml.taplo.configFile.path": ".taplo.toml",
  "sweetpad.build.xcodeWorkspacePath": "apps/macos/Voyager/Voyager.xcworkspace",
  "sweetpad.build.autoGenerateBuildServerConfig": false,
  "sweetpad.build.derivedDataPath": "${workspaceFolder}/build/dev/DerivedData",
  "sweetpad.build.args": [
    "-clonedSourcePackagesDirPath",
    "${workspaceFolder}/build/dev/SourcePackages",
    "-skipPackagePluginValidation",
    "-skipMacroValidation"
  ],
  "swift.path": "/Applications/Xcode-26.1.0.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin",
  "swift.swiftEnvironmentVariables": {
    "DEVELOPER_DIR": "/Applications/Xcode-26.1.0.app/Contents/Developer"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/backend/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/apps/backend/src"]
}
