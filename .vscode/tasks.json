      "type": "sweetpad",
      "action": "debugging-launch",
      "problemMatcher": [
        "$sweetpad-watch",
        "$sweetpad-xcodebuild-default",
        "$sweetpad-xcbeautify-errors",
        "$sweetpad-xcbeautify-warnings"
      ],
      "label": "Voyager Dev: Launch (Debug)",
      "detail": "Build and Run the Development environment on Debug mode",
      "isBackground": true,
      "scheme": "Voyager-Dev",
      "configuration": "Debug",
      "launchEnv": {
        "VOYAGER_PROJECT_ROOT": "${workspaceFolder}"
      }
    },
