{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".agents/rules/*.md"],
  "plugin": [
    ".agents/skills/common/internal/sisyphus-wiki/plugins/sisyphus-wiki.js",
    ".agents/skills/common/vendor/ponytail/.opencode/plugins/ponytail.mjs",
    ".agents/skills/common/vendor/caveman/.opencode/plugins/caveman/plugin.js",
    "context-mode"
  ],
  "lsp": {
      "sourcekit-lsp": {
        "disabled": true
      }
  },
  "mcp": {
    "cupertino": {
      "type": "local",
      "command": ["mise", "exec", "--", "cupertino", "serve"],
      "enabled": false
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npm", "exec", "--prefix", "docs/canonical", "--", "prettier", "--write", "--config", "docs/canonical/.prettierrc.json", "$FILE"],
      "extensions": [".md"]
    },
    "swiftformat": {
      "command": ["mise", "exec", "--", "swiftformat", "--config", "apps/macos/.swiftformat", "$FILE"],
      "extensions": [".swift"]
    }
  }
}
