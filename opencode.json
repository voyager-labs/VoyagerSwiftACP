{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/rules/00-core/*.md",
    ".agents/rules/10-routing/*.md",
    ".agents/rules/99-agent/01-agent-harness-artifacts.md"
  ],
  "plugin": [
    ".agents/skills/common/internal/sisyphus-wiki/plugins/sisyphus-wiki.js",
    ".agents/skills/common/vendor/ponytail/.opencode/plugins/ponytail.mjs",
    ".agents/skills/common/vendor/caveman/.opencode/plugins/caveman/plugin.js",
    "context-mode",
    "rtk"
  ],
  "lsp": {
      "sourcekit-lsp": {
        "disabled": true
      }
  },
  "mcp": {
    "cupertino": {
      "type": "local",
      "command": ["mise", "exec", "--", "cupertino", "serve"],
      "enabled": true
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": ["mise", "exec", "--", "xcodebuildmcp", "mcp"],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["mise", "exec", "--", "codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "ast-grep": {
      "type": "local",
      "command": ["mise", "exec", "--", "uvx", "--from", "git+https://github.com/ast-grep/ast-grep-mcp", "ast-grep-server"],
      "enabled": true
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "--config", "docs/canonical/.prettierrc.json", "$FILE"],
      "extensions": [".md"]
    },
    "swiftformat": {
      "command": ["mise", "exec", "--", "swiftformat", "--config", "apps/macos/.swiftformat", "$FILE"],
      "extensions": [".swift"]
    },
    "swiftlint": {
      "command": ["mise", "exec", "--", "swiftlint", "--fix", "--config", "apps/macos/.swiftlint.yml", "$FILE"],
      "extensions": [".swift"]
    }
  }
}
