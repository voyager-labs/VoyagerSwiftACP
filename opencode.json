{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/rules/00-core/*.md",
    ".agents/rules/10-routing/*.md",
    ".agents/rules/99-agent/01-agent-harness-artifacts.md"
  ],
  "mcp": {
    "cupertino": {
      "type": "local",
      "command": [
        "/usr/bin/env",
        "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/sbin:/usr/local/sbin",
        "cupertino",
        "serve"
      ],
      "enabled": true
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
      "enabled": true
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".md"]
    },
    "swiftformat": {
      "command": ["swiftformat", "$FILE"],
      "extensions": [".swift"]
    }
  }
}
