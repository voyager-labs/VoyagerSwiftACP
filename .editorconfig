root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.ipynb]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml,ini,conf,cfg,sh}]
indent_size = 2
trim_trailing_whitespace = false


[Dockerfile]
indent_size = 2

[*.env]
trim_trailing_whitespace = false

[.env.*]
trim_trailing_whitespace = false

[*.{csv,tsv}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
