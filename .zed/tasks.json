[
  // LSP context switching. Zed task variables use shell-style names.
  // Use args instead of interpolating paths into command strings so spaces are handled safely.
  {
    "label": "Voyager LSP: Current File",
    "command": "python3",
    "args": ["scripts/dev/lsp_context.py", "--path", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "current",
    "tags": ["voyager-lsp"]
  },
  {
    "label": "Voyager LSP: App",
    "command": "python3",
    "args": ["scripts/dev/lsp_context.py", "--scope", "app"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "none",
    "tags": ["voyager-lsp"]
  },
  {
    "label": "Voyager LSP: Helper",
    "command": "python3",
    "args": ["scripts/dev/lsp_context.py", "--scope", "helper"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "none",
    "tags": ["voyager-lsp"]
  },
  {
    "label": "Voyager LSP: OnboardingHost",
    "command": "python3",
    "args": ["scripts/dev/lsp_context.py", "--scope", "onboarding"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "none",
    "tags": ["voyager-lsp"]
  },

  // Affected verification planning and execution.
  {
    "label": "Voyager Checks: Current File (Plan)",
    "command": "python3",
    "args": ["scripts/dev/macos_checks.py", "--path", "$ZED_FILE", "--json"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "current",
    "tags": ["voyager-checks"]
  },
  {
    "label": "Voyager Checks: Current File (Run)",
    "command": "python3",
    "args": ["scripts/dev/macos_checks.py", "--path", "$ZED_FILE", "--run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "current",
    "tags": ["voyager-checks"]
  },
  {
    "label": "Voyager Checks: Changed Files (Plan)",
    "command": "python3",
    "args": ["scripts/dev/macos_checks.py", "--changed", "--json"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "all",
    "tags": ["voyager-checks"]
  },
  {
    "label": "Voyager Checks: Changed Files (Run)",
    "command": "python3",
    "args": ["scripts/dev/macos_checks.py", "--changed", "--run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "all",
    "tags": ["voyager-checks"]
  }
]
