{
  "name": "@voyager/storybook",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.16.0 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "preview": "vite preview",
    "storybook": "pnpm --filter @voyager-labs/file-manager-illustration build && storybook dev -p 6006",
    "typecheck": "tsc -b",
    "build-storybook": "pnpm --filter @voyager-labs/file-manager-illustration build && storybook build",
    "check": "biome check . && tsc -b && pnpm --filter @voyager-labs/file-manager-illustration typecheck"
  },
  "dependencies": {
    "@voyager-labs/file-manager-illustration": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "storybook": "^10.5.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "@storybook/addon-mcp": "^0.7.0"
  }
}
