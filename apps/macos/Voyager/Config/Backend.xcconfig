// Backend Configuration
// These are injected into the VoyagerHelper target Build Settings via .xcconfig

UV_CMD = uv
BACKEND_DIR = $(SRCROOT)/../../backend
BACKEND_HOST = ${VOYAGER_HOST}
BACKEND_PORT = ${VOYAGER_PORT}
BACKEND_URL = http://${BACKEND_HOST}:${BACKEND_PORT}
VOYAGER_PATH = /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin
VOYAGER_LOG_FILE = $(SRCROOT)/../logs/voyager.log
