--swift-version 6.2
--indent 4
--tabwidth 4
--maxwidth 120
--trimwhitespace always
--commas always
--semicolons never
--ranges spaced
--closingparen balanced
--header strip
--self remove

# Exclude build artifacts and generated files
--exclude build,Pods,.build,DerivedData

# Exclude pattern matching - ignore TCA reducer syntax
--disable redundantClosure
--disable trailingClosures
--enable organizeDeclarations
--organizationmode type
--organize-types enum
--markcategories false
--groupblanklines false

# Preserve reduce builder syntax
--ifdef no-indent

# Allow explicit self in @MainActor and escaping closures
--selfrequired @MainActor,@escaping
